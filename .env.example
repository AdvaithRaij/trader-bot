# Trading Bot Configuration
# Copy this file to .env and fill in your actual values

# ============================================
# TRADING PARAMETERS
# ============================================
INITIAL_CAPITAL=100000.0
MAX_CAPITAL_PER_TRADE=0.01
MAX_ACTIVE_TRADES=2
MAX_DAILY_LOSSES=3
MAX_DAILY_DRAWDOWN=0.05
MIN_RISK_REWARD_RATIO=1.5
AI_CONFIDENCE_THRESHOLD=0.8

# ============================================
# FYERS API CREDENTIALS
# ============================================
# Get these from: https://myapi.fyers.in/dashboard
FYERS_APP_ID=your_fyers_app_id_here
FYERS_SECRET_KEY=your_fyers_secret_key_here
FYERS_ACCESS_TOKEN=your_fyers_access_token_here
FYERS_REDIRECT_URI=https://trade.fyers.in/api-login/redirect-uri/index.html

# ============================================
# AI API KEYS (Choose one or both)
# ============================================
# OpenAI (GPT-4)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic (Claude)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ============================================
# TELEGRAM NOTIFICATIONS (Optional)
# ============================================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ============================================
# DATABASE
# ============================================
MONGODB_URL=mongodb://localhost:27017/
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=trading_bot
MONGODB_DATABASE=trading_bot

# ============================================
# REDIS (Optional)
# ============================================
REDIS_URL=redis://localhost:6379/0

# ============================================
# EXTERNAL APIs (Optional)
# ============================================
SCREENER_API_KEY=your_screener_api_key_here
CHARTINK_API_KEY=your_chartink_api_key_here
TRADINGVIEW_API_KEY=your_tradingview_api_key_here
TWITTER_BEARER_TOKEN=your_twitter_bearer_token_here

# ============================================
# MOCK MODE (Set to false for live trading)
# ============================================
MOCK_MODE=true
MOCK_BROKER=true
MOCK_AI=false

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=INFO
LOG_FILE_PATH=backend/logs/trading_bot.log

# ============================================
# DATA SOURCES
# ============================================
DATA_SOURCE=yfinance
BACKUP_DATA_SOURCE=mock
NEWS_SOURCES=google,moneycontrol,economic_times

# ============================================
# POLLING INTERVALS (in seconds)
# ============================================
INACTIVE_POLL_INTERVAL=600
ACTIVE_POLL_INTERVAL=60

